# Copy to .env and fill in. See docs/SETUP_SUPABASE.md.
#
# Leave these unset and the app runs in single-device mode: fully working, but
# each phone keeps its own private copy and nothing is shared.

# Project Settings → API → Project URL
VITE_SUPABASE_URL=

# Project Settings → API → anon / public key.
#
# This one is MEANT to be public — it is compiled into the JavaScript bundle and
# anyone can read it out of the deployed app. Row-level security is what protects
# the data, not the secrecy of this key.
#
# The service_role key is the opposite: it bypasses every rule in
# supabase/policies.sql. Never put it here. PickleTime never needs it.
VITE_SUPABASE_ANON_KEY=
